cabal-version:      2.4
name:               acnologia
version:            0.2.0
synopsis:           Client for Acnologia, a self-hosted API key server
description:
  Calls the Acnologia consumer API with an app token: send requests through
  the proxy, lease raw keys, report and renew leases, and read the token's own
  access with @me@. See the README for a quick start.
license:            MIT
author:             Sidharth P
maintainer:         Sidharth P
homepage:           https://github.com/sidharthpunathil/acnologia
bug-reports:        https://github.com/sidharthpunathil/acnologia/issues
category:           Network, Web
build-type:         Simple
extra-doc-files:    README.md
tested-with:        GHC ==9.14.1

source-repository head
  type:     git
  location: https://github.com/sidharthpunathil/acnologia.git
  subdir:   sdk/haskell

flag examples
  description: Build the acnologia-smoke example program.
  default:     False
  manual:      True

common warnings
  ghc-options:
    -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Acnologia
  build-depends:
    , aeson             >=2.0     && <2.3
    , base              >=4.17    && <5
    , bytestring        >=0.11    && <0.13
    , case-insensitive  >=1.2     && <1.3
    , containers        >=0.6     && <0.9
    , http-client       >=0.7.13  && <0.8
    , http-client-tls   >=0.3.6   && <0.4
    , http-types        >=0.12    && <0.13
    , text              >=1.2.5   && <2.2
    , time              >=1.12    && <1.16
  default-language: Haskell2010

test-suite acnologia-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  ghc-options:      -threaded
  build-depends:
    , acnologia
    , aeson
    , base
    , bytestring
    , case-insensitive
    , containers
    , http-client
    , http-types
    , tasty             >=1.4   && <1.6
    , tasty-hunit       >=0.10  && <0.11
    , text
    , time
    , wai               >=3.2   && <3.3
    , warp              >=3.3   && <3.5
  default-language: Haskell2010

-- Runs proxy, lease, renew, report and me against a real server, reading
-- ACNOLOGIA_URL and ACNOLOGIA_TOKEN. Built only with -fexamples.
executable acnologia-smoke
  import:           warnings
  hs-source-dirs:   examples
  main-is:          Smoke.hs
  build-depends:
    , acnologia
    , aeson
    , base
    , bytestring
    , text
  default-language: Haskell2010
  if !flag(examples)
    buildable: False
