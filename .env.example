# Copy to .env and fill in. .env is gitignored. Acnologia reads it on start
# (real environment variables win over the file). Variables still named
# COGITO_* from before the rename keep working, with a warning at startup.

# 32 random bytes, base64. Generate with: ./bin/acnologia gen-master-key
# Keep it safe: without it, stored API keys cannot be decrypted.
ACNOLOGIA_MASTER_KEY=

# Enables the AI features: the Assistant, the provider builder, "Fill with AI"
# and the scheduled provider offers refresh. Leave empty to disable them.
ANTHROPIC_API_KEY=
# Fallback Claude model. A model picked under Settings, AI wins over it.
ACNOLOGIA_AI_MODEL=claude-opus-5-5
# Optional: prompt size in tokens at which an Assistant chat is compacted.
# Empty or 0 means 60% of the model's context window.
ACNOLOGIA_CHAT_COMPACT_TOKENS=
# Optional: lets the agent read GitHub repos without the low anonymous rate limit.
GITHUB_TOKEN=

# Listen address. Unset, the server uses 0.0.0.0:$PORT when the host sets PORT
# (Railway, Render, Fly), else :8080.
ACNOLOGIA_ADDR=:8080
# Default ./data, or %LocalAppData%\Acnologia on Windows.
ACNOLOGIA_DATA_DIR=./data

# Public URL (optional) for the links the server writes (the MCP endpoint on
# the Apps page, the acn login link) and for the identity and invites it gives
# other servers when sharing. Set it on any server that shares.
ACNOLOGIA_PUBLIC_URL=

# Set true when served over HTTPS so the session cookie is Secure.
ACNOLOGIA_SECURE_COOKIES=false

# Set true only behind a reverse proxy that overwrites X-Forwarded-For and
# X-Real-IP. When false, those headers are ignored, so clients cannot spoof
# their address to dodge the login rate limit.
ACNOLOGIA_TRUST_PROXY_HEADERS=false

# Site-wide access password (12+ characters). Set it on any instance reachable
# from the internet: every visitor sees a lock screen before setup, sign in or
# any data. Scripts send it in the X-Acnologia-Access header. Empty: no lock.
ACNOLOGIA_ACCESS_PASSWORD=
# true: never come up unlocked. A set password must be 12+ characters; with
# none, one is generated into access-password in the data dir. Use it on a
# public deploy.
ACNOLOGIA_REQUIRE_ACCESS_PASSWORD=false
# true (default): the access password is the whole login, no email form.
# false: keep separate accounts behind the lock screen.
ACNOLOGIA_ACCESS_SIGNS_IN=true
# How long a browser stays unlocked: days (7, 7d) or a duration (12h).
# Default 30d.
ACNOLOGIA_ACCESS_TTL=

# Optional: create the first superadmin on boot instead of the setup screen.
ACNOLOGIA_BOOTSTRAP_EMAIL=
ACNOLOGIA_BOOTSTRAP_PASSWORD=

# How often to re-check key quotas with the provider (0 disables). Default 6h.
ACNOLOGIA_HEALTH_INTERVAL=6h
# Days to keep request events; 0 or less keeps them forever.
ACNOLOGIA_EVENT_RETENTION_DAYS=30
ACNOLOGIA_MAX_BODY_MB=50

# Memory for cached GET responses and idempotent replays (MB, 0 turns it off).
ACNOLOGIA_CACHE_MB=64

# Let webhooks reach private networks (for a receiver on your LAN).
ACNOLOGIA_WEBHOOK_ALLOW_PRIVATE=false

# URL the egress proxy test calls to learn a proxy's public IP.
ACNOLOGIA_EGRESS_ECHO_URL=https://www.cloudflare.com/cdn-cgi/trace
