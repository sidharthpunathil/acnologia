# Copy to .env and fill in. .env is gitignored. Cogito reads it on start
# (real environment variables win over the file).

# 32 random bytes, base64. Generate with: ./bin/cogito gen-master-key
# Keep it safe: without it, stored API keys cannot be decrypted.
COGITO_MASTER_KEY=

# AI provider builder and "Fill with AI". Leave empty to disable AI features.
ANTHROPIC_API_KEY=
COGITO_AI_MODEL=claude-opus-5-5
# Optional: lets the agent read GitHub repos without the low anonymous rate limit.
GITHUB_TOKEN=

COGITO_ADDR=:8080
COGITO_DATA_DIR=./data

# Public URL used in llms.txt and docs (optional).
COGITO_PUBLIC_URL=

# Set true when served over HTTPS so the session cookie is Secure.
COGITO_SECURE_COOKIES=false

# Optional: create the first superadmin on boot instead of the setup screen.
COGITO_BOOTSTRAP_EMAIL=
COGITO_BOOTSTRAP_PASSWORD=

# How often to re-check key quotas with the provider (0 disables). Default 6h.
COGITO_HEALTH_INTERVAL=6h
COGITO_EVENT_RETENTION_DAYS=30
COGITO_MAX_BODY_MB=50
